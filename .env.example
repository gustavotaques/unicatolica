# Ambiente local reprodutível (AD-7). Copie para `.env` e ajuste se precisar —
# `.env` nunca é commitado (ver .gitignore). Segredos reais (produção) só via
# variáveis de ambiente do provedor de hosting, nunca aqui.

# Postgres (docker-compose "db" e datasource do backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pacext
DB_USER=pacext
DB_PASSWORD=pacext

# Segurança JWT (AD-2) — issuer esperado nos tokens validados pelo JwtSecurityFilter
JWT_ISSUER=https://pacext.unicatolica.edu.br

# CORS (AD-2/AD-6) — origem liberada para o Angular dev server
CORS_ORIGINS=http://localhost:4200

# Frontend — URL base da API que a SPA Angular vai consumir. Reservada para quando
# o frontend passar a ler config de ambiente (nenhuma tela/serviço Angular lê esta
# variável ainda nesta história de scaffold).
API_URL=http://localhost:8080
