<?xml version="1.0" encoding="UTF-8"?>
<!--
    Usuário semente para teste manual do login (Story 1.4), com o e-mail já confirmado
    (Story 1.3). Senha em texto puro: "Senha123!". Roda só em contexto "dev"
    (quarkus.liquibase.contexts, vazio em %prod) — nunca em produção.

    Insert em duas etapas via SQL bruto (CTE) porque o id de usuario é gerado pelo banco
    (IDENTITY) e usuario_papel precisa dele como FK — Liquibase XML não encadeia
    <insert> declarativo usando o id gerado do <insert> anterior.

    Hash gerado com io.quarkus.elytron.security.common.BcryptUtil.bcryptHash (o que
    AuthService usa para conferir a senha) — NÃO reaproveitar hash de outra lib de bcrypt
    (ex.: at.favre.lib), prefixo diferente ($2b$ vs $2a$) falha em runtime com
    "ELY08003: Unknown crypt string algorithm" (achado testando este merge ao vivo).
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="identidade-002-seed-usuario-teste" author="pacext" context="dev">
        <sql>
            WITH novo_usuario AS (
                INSERT INTO usuario (nome, email, senha_hash, data_nascimento, curso, email_confirmado, criado_em)
                VALUES ('Aluno Teste', 'aluno.teste@catolicasc.edu.br',
                        '$2a$10$Mgv/kTo93gBOtjTnTnwofO7rVRR93dmDeMc68IsUN3zZ92uFAsbVO',
                        '2000-01-01', 'Engenharia de Software', true, now())
                RETURNING id
            )
            INSERT INTO usuario_papel (usuario_id, papel)
            SELECT id, 'ALUNO' FROM novo_usuario;
        </sql>
        <rollback>
            <sql>DELETE FROM usuario WHERE email = 'aluno.teste@catolicasc.edu.br'</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
