<?xml version="1.0" encoding="UTF-8"?>
<!--
    Usuário semente para teste manual do login (Story 1.4). O fluxo de cadastro
    (Story 1.2) e confirmação de e-mail (Story 1.3) ainda não existem no backend —
    sem este seed não haveria nenhum usuário com email_confirmado=true para testar
    POST /auth/login de ponta a ponta. Senha em texto puro: "Senha123!".
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="identidade-002-seed-usuario-teste" author="pacext" context="dev">
        <insert tableName="usuario">
            <column name="nome" value="Aluno Teste"/>
            <column name="email" value="aluno.teste@catolicasc.edu.br"/>
            <column name="senha_hash" value="$2b$10$HBRjYZYGl7EqrU1DA9coJ.ugYuaB/mT5uZ9DljMjP8HUrLSc8yRWi"/>
            <column name="perfil" value="ALUNO"/>
            <column name="email_confirmado" valueBoolean="true"/>
            <column name="criado_em" valueComputed="now()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
